#!/bin/bash
# ═══════════════════════════════════════════════════════════
# Jbium — Unix Launcher
# ═══════════════════════════════════════════════════════════

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Find Python 3
if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    echo "Error: Python 3.8+ required"
    exit 1
fi

# Launch
exec "$PYTHON" "$SCRIPT_DIR/stealth_browser.py" "$@"
